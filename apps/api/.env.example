HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Local Docker only. Use a server-side PostgreSQL connection URL for Supabase.
DATABASE_URL=postgresql://verascribe:local-development-only@127.0.0.1:54329/verascribe
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
# Downloads a pinned quantized model on first use; cache is ignored by Git.
RERANK_ENABLED=true
RERANK_TOP_K=5
RERANK_BATCH_SIZE=4
RERANK_LOCAL_FILES_ONLY=false
# RERANK_CACHE_DIR=/absolute/path/to/model-cache
# Used by the answer CLIs and query API; never expose to the frontend.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GENERATION_TIMEOUT_MS=30000

# Local verification: initial thresholds
NLI_BATCH_SIZE=4
NLI_LOCAL_FILES_ONLY=false
NLI_ENTAILMENT_THRESHOLD=0.8
MINIMUM_SUPPORT_RATIO=0.5

# Enable after configuring providers and ingesting documents.
QUERY_ENABLED=false
QUERY_TIMEOUT_MS=120000

# Serve the built UI from the API for a same-origin local release.
SERVE_WEB=false
