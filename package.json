{
  "name": "verascribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @verascribe/api\" \"npm run dev -w @verascribe/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "db:migrate": "npm run db:migrate -w @verascribe/api",
    "ingest": "npm run ingest -w @verascribe/api --",
    "document:delete": "npm run document:delete -w @verascribe/api --",
    "search": "npm run search -w @verascribe/api --",
    "eval:retrieval": "npm run eval:retrieval -w @verascribe/api",
    "rerank:smoke": "npm run rerank:smoke -w @verascribe/api",
    "generate": "npm run generate -w @verascribe/api --",
    "verify:smoke": "npm run verify:smoke -w @verascribe/api",
    "answer": "npm run answer -w @verascribe/api --",
    "eval:verification": "npm run eval:verification -w @verascribe/api",
    "ingest:pdf": "npm run ingest:pdf -w @verascribe/api --",
    "ingest:url": "npm run ingest:url -w @verascribe/api --",
    "demo:doctor": "npm run demo:doctor -w @verascribe/api",
    "eval:verification:check": "npm run eval:verification -w @verascribe/api -- --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
